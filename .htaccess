# ============================================================
# Coaching Center – cPanel / Apache configuration
# Place this file in public_html/abms/
# ============================================================

# Enable Passenger Node.js application
PassengerEnabled on
PassengerAppType node
PassengerStartupFile server.js

# ─── Block web access to sensitive directories and files ───

# Block backend source code, data and supabase directories.
# (<DirectoryMatch> is not valid in .htaccess, so mod_rewrite is used.
#  In per-directory context the path is relative to /abms/, so the
#  pattern is anchored to top-level folders only.
#  frontend/js/* is NOT matched.)
RewriteEngine On
RewriteRule ^(backend|data|supabase)(/|$) - [F,NC,L]

# Block .env files
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

# Block SQLite database files
<FilesMatch "\.db$">
  Require all denied
</FilesMatch>

# Block server-side-only .js files by name.
# NOTE: api.js and auth.js were REMOVED from this list because they
# also exist as public files in frontend/js/ and were causing 403.
# Real backend copies remain protected by the directory rule above.
<FilesMatch "^(database|staffAdmin)\.js$">
  Require all denied
</FilesMatch>

# ─── Security headers ───
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Redirect bare /abms to /abms/frontend/login.html ───
RedirectMatch ^/abms/?$ /abms/frontend/login.html